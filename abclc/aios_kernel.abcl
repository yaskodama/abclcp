class EchoService {
  method ping(message) {
    reply("echo: " + message);
  }
}

var echo = new EchoService();

print(aios_kernel());
print(capabilities());
print(capability_prims("AIOS.Kernel"));
print(aios_actors());
print(aios_actor_info("echo"));
print(aios_actor_methods("echo"));
print(aios_mailbox_len("echo"));

var answer = now echo.ping("ready");
print("kernel now = " + answer);

var pending = future echo.ping("future-ready");
var resolved = await pending;
print("kernel future = " + resolved);
