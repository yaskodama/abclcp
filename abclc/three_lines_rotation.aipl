class Window {
  method create(width, height, title) {
    openWindow(width, height, title);
  }

  method drawLine(x1, y1, x2, y2) {
    clear();
    drawLine(x1, y1, x2, y2);
    flush();
  }
}

class Line {
  var cx = 200.0;
  var cy = 200.0;
  var angle = 0.0;
  var offset = 0.0;
  var len = 50.0;
  var window = 0;   // FIXME: アクターを保持するフィールド

  method rotate() {
    angle = angle + 5.0;
    if (angle >= 360.0) {
      angle = 0.0;
    }

    var rad = (angle + offset) * 3.14159 / 180.0;
    var dx = len * cos(rad);
    var dy = len * sin(rad);
    var x1 = cx - dx;
    var y1 = cy - dy;
    var x2 = cx + dx;
    var y2 = cy + dy;

    send window.drawLine(x1, y1, x2, y2);
    send self.rotate();
  }
}

var win = new Window();
send win.create(400, 400, "Rotating Lines");

var line1 = new Line();

send line1.set_window(win);

send line1.set_offset(0.0);
var line2 = new Line();
send line2.set_window(win);
send line2.set_offset(120.0);
var line3 = new Line();
send line3.set_window(win);
send line3.set_offset(240.0);

send line1.rotate();
send line2.rotate();
send line3.rotate();
