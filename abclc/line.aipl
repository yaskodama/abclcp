class Line {
  var angle = 0.0;
  var cx = 320;
  var cy = 240;
  var length = 100;

  method spin() {
    print(angle);
    w.x1 = cx + length * cos(angle);
    w.y1 = cy + length * sin(angle);
    w.x2 = cx - length * cos(angle);
    w.y2 = cy - length * sin(angle);
    send w.line();
    angle = angle + 0.1;
    send self.spin();
  }
}
