class Fork {
  var taken = 0;

  method take() {
    if (taken == 0) {
      taken = 1;
    } else {
      send self.take();
    }
  }

  method release() {
    taken = 0;
  }
}

class Philosopher {
  var id = 0;
  // 核では、アクターを持つフィールドは new で初期化してから差し替える。
  // ここで作る Fork は場所取りで、set_ で本物に置き換わる。
  var leftFork = new Fork();
  var rightFork = new Fork();

  method set_id(v)          : unit !{mut} { id = v; }
  method set_leftFork(f: Fork)  : unit !{mut} { leftFork = f; }
  method set_rightFork(f: Fork) : unit !{mut} { rightFork = f; }

  method think() {
    send self.hungry();
  }

  method hungry() {
    send leftFork.take();
    send rightFork.take();
    send self.eat();
  }

  method eat() {
    send leftFork.release();
    send rightFork.release();
    send self.think();
  }
}

var fork0 = new Fork();
var fork1 = new Fork();
var fork2 = new Fork();
var fork3 = new Fork();
var fork4 = new Fork();

var p0 = new Philosopher();

send p0.set_id(0);

send p0.set_leftFork(fork0);

send p0.set_rightFork(fork1);
var p1 = new Philosopher();
send p1.set_id(1);
send p1.set_leftFork(fork1);
send p1.set_rightFork(fork2);
var p2 = new Philosopher();
send p2.set_id(2);
send p2.set_leftFork(fork2);
send p2.set_rightFork(fork3);
var p3 = new Philosopher();
send p3.set_id(3);
send p3.set_leftFork(fork3);
send p3.set_rightFork(fork4);
var p4 = new Philosopher();
send p4.set_id(4);
send p4.set_leftFork(fork4);
send p4.set_rightFork(fork0);

send p0.think();
send p1.think();
send p2.think();
send p3.think();
send p4.think();
