class Line {
  var cx = 200.0;
  var cy = 200.0;
  var angle = 0.0;
  var offset = 0.0;
  var len = 50.0;
  var x1 = 0.0; var y1 = 0.0; var x2 = 0.0; var y2 = 0.0;
  var ox1 = 0.0; var oy1 = 0.0; var ox2 = 0.0; var oy2 = 0.0;
  method init(a_cy) { cy = a_cy; }

  method start() {
    var xx1 = 50.0; var yy1 = 50.0; var scale = 2.0;
    sdl_clear();
    sdl_line(xx1,yy1,xx1,yy1+(40.0 * scale));
    sdl_line(xx1,yy1+(40.0 * scale),xx1+(20.0 * scale),yy1+(40.0 * scale));
    sdl_line(xx1+(20.0 * scale),yy1+(40.0 * scale),xx1+(20.0 * scale),yy1);
    var xx2 =x1+(50.0 * scale);
    sdl_line(xx2,yy1+(20.0 * scale),xx2,yy1+(40.0 * scale));
    sdl_line(xx2,yy1+(20.0 * scale),xx2+(15.0 * scale),yy1+(20.0 * scale));
    sdl_line(xx2+(15.0 * scale),yy1+(20.0 * scale),xx2+(15.0 * scale),yy1+(40.0 * scale));
    var xx3 =xx2+(25.0 * scale);
    sdl_line(xx3,yy1+(20.0 * scale),xx3,yy1+(40.0 * scale));
    sdl_line(xx3,yy1+(15.0 * scale),xx3,yy1+(17.0 * scale));
    var xx4 =xx3+(10.0 * scale);
    sdl_line(xx4,yy1+(20.0 * scale),xx4+(7.0 * scale),yy1+(40.0 * scale));
    sdl_line(xx4+(7.0 * scale),yy1+(40.0 * scale),xx4+(14.0 * scale),yy1+(20.0 * scale));
    var xx5 =xx4+(20.0 * scale);
    sdl_line(xx5+(15.0 * scale),yy1+(25.0 * scale),xx5,yy1+(25.0 * scale));
    sdl_line(xx5,yy1+(25.0 * scale),xx5,yy1+(35.0 * scale));
    sdl_line(xx5,yy1+(35.0 * scale),xx5+(15.0 * scale),yy1+(35.0 * scale));
    sdl_line(xx5+(15.0 * scale),yy1+(35.0 * scale),xx5+(15.0 * scale),yy1+(25.0 * scale));
    sdl_line(xx5+(15.0 * scale),yy1+(40.0 * scale),xx5,yy1+(40.0 * scale));
    sdl_line(xx5,yy1+(35.0 * scale),xx5,yy1+(40.0 * scale));
    var xx6 =xx5+(20.0 * scale);
    sdl_line(xx6,yy1+(25.0 * scale),xx6,yy1+(40.0 * scale));
    sdl_line(xx6,yy1+(25.0 * scale),xx6+(10.0 * scale),yy1+(25.0 * scale));
    sdl_line(xx6+(10.0 * scale),yy1+(25.0 * scale),xx6+(10.0 * scale),yy1+(30.0 * scale));
    var xx7 =xx6+(15.0 * scale);
    sdl_line(xx7+(15.0 * scale),yy1+(25.0 * scale),xx7,yy1+(25.0 * scale));
    sdl_line(xx7,yy1+(25.0 * scale),xx7,yy1+(32.0 * scale));
    sdl_line(xx7,yy1+(32.0 * scale),xx7+(15.0 * scale),yy1+(32.0 * scale));
    sdl_line(xx7+(15.0 * scale),yy1+(32.0 * scale),xx7+(15.0 * scale),yy1+(40.0 * scale));
    sdl_line(xx7+(15.0 * scale),yy1+(40.0 * scale),xx7,yy1+(40.0 * scale));
    var xx8 =xx7+(20.0 * scale);
    sdl_line(xx8,yy1+(20.0 * scale),xx8,yy1+(40.0 * scale));
    sdl_line(xx8,yy1+(15.0 * scale),xx8,yy1+(17.0 * scale));
    var xx9 =xx8+(10.0 * scale);
    sdl_line(xx9,yy1+(20.0 * scale),xx9,yy1+(40.0 * scale));
    sdl_line(xx9-(5.0 * scale),yy1+(20.0 * scale),xx9+(5.0 * scale),yy1+(20.0 * scale));
    var xx10 =xx9+(10.0 * scale);
    sdl_line(xx10,yy1+(20.0 * scale),xx10+(7.0 * scale),yy1+(30.0 * scale));
    sdl_line(xx10+(14.0 * scale),yy1+(20.0 * scale),xx10+(7.0 * scale),yy1+(30.0 * scale));
    sdl_line(xx10+(7.0 * scale),yy1+(30.0 * scale),xx10+(7.0 * scale),yy1+(40.0 * scale));
    sdl_present();
  }

  method rotate() {
    angle = angle + 5.0;
    var rad = (angle + offset) * 3.14159 / 180.0;
    var dx = len * cos(rad);
    var dy = len * sin(rad);
    ox1 = x1; oy1 = y1; ox2 = x2;oy2 = y2;
    x1 = cx - dx; y1 = cy - dy; x2 = cx + dx; y2 = cy + dy;
    sdl_erase_line(ox1, oy1, ox2, oy2);
    sdl_line(x1, y1, x2, y2);    
    sdl_present();
    wait(100);
    send li.rotate();
  }
}

var li = new Line(500.0);
