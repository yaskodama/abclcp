class Fork0 { var held = 0.0; method take() { if (held == 0.0) { held = 1.0; } else { send self.take(); } } method put() { held = 0.0; } }
class Fork1 { var held = 0.0; method take() { if (held == 0.0) { held = 1.0; } else { send self.take(); } } method put() { held = 0.0; } }
class Fork2 { var held = 0.0; method take() { if (held == 0.0) { held = 1.0; } else { send self.take(); } } method put() { held = 0.0; } }
class Fork3 { var held = 0.0; method take() { if (held == 0.0) { held = 1.0; } else { send self.take(); } } method put() { held = 0.0; } }
class Fork4 { var held = 0.0; method take() { if (held == 0.0) { held = 1.0; } else { send self.take(); } } method put() { held = 0.0; } }
class Philosopher0 {
  var f_fork0 = new Fork0();
  var f_fork1 = new Fork1();

  var count = 0.0;
  method think_eat() {
    send f_fork0.take();
    send f_fork1.take();
    count = count + 1.0;
    print(count);
    send f_fork0.put();
    send f_fork1.put();
    send self.think_eat();
  }
}
