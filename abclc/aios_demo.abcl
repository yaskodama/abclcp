class MemoryService {
  var last_key = "";
  var last_value = "";

  method put(key, value) {
    last_key = key;
    last_value = value;
    reply("ok");
  }

  method get(key) {
    reply(last_value);
  }
}

class ModelService {
  method generate(prompt) {
    reply("plan(" + prompt + ")");
  }
}

class ToolService {
  method run(name, input) {
    reply("tool:" + name + ":" + input);
  }
}

class AgentService {
  method handle(goal) {
    aios_emit("observe:" + goal);
    aios_now("memory", "put", "goal", goal);

    var plan_future = aios_future("model", "generate", goal);
    var plan = await plan_future;
    aios_emit("plan:" + plan);

    var action = aios_now("tool", "run", "execute", plan);
    aios_emit("act:" + action);
    reply(action);
  }
}

var memory = new MemoryService();
var model = new ModelService();
var tool = new ToolService();
var agent = new AgentService();

aios_register_service("memory", "memory");
aios_register_service("model", "model");
aios_register_service("tool", "tool");
aios_register_service("agent", "agent");

print("== AIOS kernel ==");
print(aios_kernel());
print(aios_services());
print(aios_actor_info("agent"));

var result = aios_now("agent", "handle", "ship-demo");
print("agent result = " + result);

var saved = aios_now("memory", "get", "goal");
print("memory goal = " + saved);

print("== AIOS events ==");
print(aios_events());
