class Line {
  var angle = 0.0;
  var cx = 320.0;
  var cy = 240.0;
  var length = 100.0;
  method init(a_cx, a_cy, a_angle) { cx = a_cx; cy = a_cy; angle = a_angle; }

  method spin() {
    sdl_clear();
    var x1 = cx + length * cos(angle);
    var y1 = cy + length * sin(angle);
    var x2 = cx - length * cos(angle);
    var y2 = cy - length * sin(angle);
    sdl_line(x1, y1, x2, y2);
    sdl_present();
    angle = angle + 0.1;
    send self.spin();
  }
}

var l1 = new Line(200.0, 200.0, 0.0);
var l2 = new Line(400.0, 300.0, 1.0);
var l3 = new Line(300.0, 400.0, 2.0);
