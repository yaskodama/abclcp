class PlannerAI {
  method plan(problem) {
    aios_emit("planner.observe:" ++ problem);
    reply("steps: identify facts -> solve -> review");
  }
}

class SolverAI {
  method solve(problem, plan) {
    aios_emit("solver.using:" ++ plan);
    reply("answer: 12 because 3 groups of 4 make 12");
  }
}

class ReviewerAI {
  method review(problem, answer) {
    aios_emit("reviewer.check:" ++ answer);
    reply("review: accepted for " ++ problem);
  }
}

class CoordinatorAI {
  method solve(problem) {
    aios_emit("coordinator.problem:" ++ problem);

    var plan_future = aios_future("planner", "plan", problem);
    var plan = await plan_future;
    aios_emit("coordinator.plan:" ++ plan);

    var answer_future = aios_future("solver", "solve", problem, plan);
    var answer = await answer_future;
    aios_emit("coordinator.answer:" ++ answer);

    var review = aios_now("reviewer", "review", problem, answer);
    aios_emit("coordinator.review:" ++ review);

    reply(answer ++ " | " ++ review);
  }
}

var planner = new PlannerAI();
var solver = new SolverAI();
var reviewer = new ReviewerAI();
var coordinator = new CoordinatorAI();

aios_register_service("planner", "planner");
aios_register_service("solver", "solver");
aios_register_service("reviewer", "reviewer");
aios_register_service("coordinator", "coordinator");

print("== Multi-AI cooperative solve ==");
print(aios_services());

protocol_define("MultiAISolve", "coordinator.solve -> planner.plan -> solver.solve -> reviewer.review");
var sid = protocol_start("MultiAISolve");
print(protocol_state(sid));

var result = aios_now("coordinator", "solve", "If there are 3 boxes with 4 apples each, how many apples are there?");

print("final result = " ++ result);
print(protocol_state(sid));
protocol_end(sid);
print(protocol_state(sid));
print("== protocol events ==");
print(protocol_events());
print("== coordination events ==");
print(aios_events());
