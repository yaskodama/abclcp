class KernelMemoryService {
  method put(key, value) {
    aios_memory_put(key, value);
    reply("ok");
  }

  method get(key) {
    reply(aios_memory_get(key));
  }

  method has(key) {
    reply(aios_memory_has(key));
  }

  method keys() {
    reply(aios_memory_keys());
  }
}

var memory = new KernelMemoryService();

aios_register_service("memory", "memory");

print("== AIOS kernel memory store ==");
print(aios_service_info("memory"));

aios_now("memory", "put", "problem", "3 boxes with 4 apples");
aios_now("memory", "put", "answer", "12");

print("memory keys = " + aios_now("memory", "keys"));
print("memory problem = " + aios_now("memory", "get", "problem"));
print("memory answer = " + aios_now("memory", "get", "answer"));
print("memory has answer = " + aios_now("memory", "has", "answer"));
print(aios_events());
