class Line {
  var angle = 0.0;
  var cx = 320.0;
  var cy = 240.0;
  var length = 100.0;

  method spin() {
    var x1 = cx + length * cos(angle);
    var y1 = cy + length * sin(angle);
    var x2 = cx - length * cos(angle);
    var y2 = cy - length * sin(angle);
    sdl_clear();
    sdl_line(x1, y1, x2, y2);
    sdl_present();
    angle = angle + 0.1;
    send self.spin();
  }
}

var l1 = new Line();
var l2 = new Line();
var l3 = new Line();
