class TaskService {
  method create(title) {
    reply(aios_task_create(title));
  }

  method set(task, field, value) {
    aios_task_set(task, field, value);
    reply("ok");
  }

  method get(task, field) {
    reply(aios_task_get(task, field));
  }

  method info(task) {
    reply(aios_task_info(task));
  }
}

class ModelRouterService {
  var provider = "gemini";

  method use(name) {
    provider = name;
    aios_emit("model.provider:" ++ provider);
    reply("ok");
  }

  method generate(prompt) {
    aios_emit("model.generate:" ++ provider);
    var answer = model_generate(provider, prompt);
    aios_emit("model.answer:" ++ answer);
    reply(answer);
  }
}

class WorkflowAgentService {
  method solve(title, problem) {
    aios_emit("workflow.start:" ++ title);

    var tid = aios_now("task", "create", title);
    aios_now("task", "set", tid, "problem", problem);
    aios_now("task", "set", tid, "status", "solving");

    var solve_prompt = "Solve this problem in Japanese. Keep the final answer concise. Problem: " ++ problem;
    var answer_future = aios_future("model", "generate", solve_prompt);
    var answer = await answer_future;
    aios_now("task", "set", tid, "answer", answer);

    aios_now("task", "set", tid, "status", "reviewing");
    var review_prompt = "Review this answer in Japanese. Say whether it is correct and concise. Problem: " ++ problem ++ " Answer: " ++ answer;
    var review_future = aios_future("model", "generate", review_prompt);
    var review = await review_future;
    aios_now("task", "set", tid, "review", review);
    aios_now("task", "set", tid, "status", "done");

    aios_emit("workflow.done:" ++ tid);
    reply(tid);
  }
}

var task = new TaskService();
var model = new ModelRouterService();
var agent = new WorkflowAgentService();

aios_register_service("task", "task");
aios_register_service("model", "model");
aios_register_service("agent", "agent");

print("== AIOS Gemini workflow ==");
print(aios_services());

aios_now("model", "use", "gemini");
var tid = aios_now("agent", "solve", "solve apple problem", "箱が3つあり、それぞれにリンゴが4個あります。リンゴは全部で何個ですか。");

print("task id = " ++ tid);
print(aios_now("task", "info", tid));
print("answer = " ++ aios_now("task", "get", tid, "answer"));
print("review = " ++ aios_now("task", "get", tid, "review"));
print(aios_events());
