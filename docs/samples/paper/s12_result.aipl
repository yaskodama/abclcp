// s12: 失敗を型で表す ---- else を書かない待ちは result<τ> になる
//
//      期限切れの値と正常な値が同じ型だと、
//      「この値は本当に計算されたのか」をプログラムが問えない。
//      else を書かなければ result<τ> が返り、is_ok / value で取り出す。
//      result<τ> は数値としては使えないので、確かめずに流すことができない。
class Svc {
  method fast(x)  : int { reply(x); }
  method never(x) : int { while 1 > 0 do { } reply(x); }
}
class Caller2 {
  var s = new Svc();
  method run() : unit !{log} {
    var a = now s.fast(42) timeout 200;      // result<int>
    if (is_ok(a)) { print("fast ok " ++ value(a, -1)); }
    else          { print("fast timed out"); }
  }
}
var c = new Caller2();
send c.run();
