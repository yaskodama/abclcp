// select / case / timeout
class Worker {
  method job(k) : string {
    reply("direct:" ++ k);
  }
  method serve() : unit {
    print("waiting");
    select {
      case job(k) -> { print("got " ++ k); reply("via select:" ++ k); }
      timeout 500 -> { print("timed out"); }
    }
  }
}
var w = new Worker();
send w.serve();
print(now w.job(1));
